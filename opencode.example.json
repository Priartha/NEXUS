{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "binance-crypto": {
      "type": "local",
      "command": ["python", "backend/mcp/binance_server.py"],
      "enabled": true,
      "env": {}
    },
    "coingecko": {
      "type": "local",
      "command": ["python", "backend/mcp/coingecko_server.py"],
      "enabled": true,
      "env": {}
    },
    "coinmarketcap": {
      "type": "local",
      "command": ["python", "backend/mcp/coinmarketcap_server.py"],
      "enabled": true,
      "env": {
        "CMC_API_KEY": ""
      }
    }
  }
}
