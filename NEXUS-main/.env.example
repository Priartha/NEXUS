# ICT Terminal Configuration

# Deployment
ENVIRONMENT=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
NEXUS_VERSION=1.0.0
VITE_API_BASE_URL=https://your-api-domain.com
VITE_WS_URL=wss://your-api-domain.com/ws/chart

# Backend Core
DELTA_REST_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
ICT_SYMBOL=BTCUSD
ICT_TIMEFRAMES=5m,15m,1h,4h
ICT_TIMEFRAME=5m
ICT_MAX_CANDLES=1000
ICT_HISTORY_SEED_CANDLES=700
ICT_MARKET_DATA_PROVIDER=delta
ICT_MARKET_DATA_REST_BASE_URL=https://api.binance.com
ICT_MARKET_DATA_WS_URL=wss://stream.binance.com:9443
ICT_MARKET_DATA_REST_POLL_SECONDS=1
ICT_WS_RECONNECT_INITIAL_SECONDS=2
ICT_WS_RECONNECT_MAX_SECONDS=30
ICT_API_KEY=your-secure-api-key-here

# Delta Exchange Futures
DELTA_FUTURES_PRODUCT_ID=27
DELTA_FUTURES_LEVERAGE=10
DELTA_FUTURES_MARGIN_MODE=cross
DELTA_FUTURES_FUNDING_REFRESH_SECONDS=30
DELTA_FUTURES_OI_REFRESH_SECONDS=30
DELTA_FUTURES_LIQ_REFRESH_SECONDS=60
DELTA_FUTURES_DEFAULT_FUNDING=-0.0001

# AI Integration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
ICT_AI_ICT_PROVIDER=auto
ICT_SENTIMENT_PROVIDER=auto
ICT_SENTIMENT_MODEL=gpt-4o-mini

# Analysis Parameters
ICT_SENTIMENT_REFRESH_SECONDS=300
ICT_AI_ICT_REFRESH_SECONDS=180

# Scalp Engine
NEXUS_SCALP_ENABLED=true
NEXUS_SCALP_MIN_CONFLUENCE=0.60
NEXUS_SCALP_MIN_DIRECTIONAL_EDGE=0.08
NEXUS_SCALP_MIN_VOLUME_IMPULSE=0.60
NEXUS_SCALP_MIN_RRR=2.5
NEXUS_SCALP_REQUIRE_CANDLE_CONFIRMATION=false
NEXUS_SCALP_REQUIRE_MTF_ALIGNMENT=false
NEXUS_SCALP_MAX_POSITIONS=1
NEXUS_SCALP_DAILY_LOSS_PCT=0.03
NEXUS_SCALP_MAX_HOLD_MINUTES=30
NEXUS_SCALP_PARTIAL_EXIT=0.60
NEXUS_SCALP_BE_PREMIUM_PCT=0.50
NEXUS_SCALP_MAX_RISK_PCT=0.015
NEXUS_SCALP_MAX_LEVERAGE=15
NEXUS_SCALP_FUNDING_EXTREME=0.0015
NEXUS_SCALP_MIN_VOL_RATIO=0.60
NEXUS_SCALP_VWAP_SD=1.0
NEXUS_SCALP_RSI_EXHAUSTION=3
NEXUS_SCALP_MIN_TREND_STRENGTH=0.0002
NEXUS_SCALP_MAX_ENTRY_DISTANCE_PCT=0.005

# Wick Rejection Analysis
NEXUS_SCALP_WICK_MIN_RATIO=2.0
NEXUS_SCALP_WICK_LOOKBACK=5
NEXUS_SCALP_WICK_MAX_LOOKBACK=8

# Profitability Validation Gate
NEXUS_REQUIRE_PROFITABILITY_VALIDATION=false
NEXUS_PROFITABILITY_VALIDATION_PATH=data/profitability_validation.json
NEXUS_PROFITABILITY_MIN_TRADES=100
NEXUS_PROFITABILITY_MIN_WIN_RATE=0.50
NEXUS_PROFITABILITY_MIN_PF=1.50
NEXUS_PROFITABILITY_MAX_DD_PCT=15.0

# Backtest & Route
NEXUS_BACKTEST_ROUTE_MAX_CANDLES=200
NEXUS_BACKTEST_ROUTE_TIMEOUT_SECONDS=45
NEXUS_BACKTEST_ADAPTIVE_MAX_CANDIDATES=3

# System
NEXUS_DB_INTEGRITY_TIMEOUT_SECONDS=8
NEXUS_SNAPSHOT_TIMEOUT_SECONDS=15
NEXUS_AUTO_INSTALL_DEPS=false
NEXUS_ENABLE_PATTERN_STARTUP_SEED=false
NEXUS_PATTERN_SEED_MAX_SEGMENTS=250

# Trader Profile
NEXUS_TRADER_PROFILE_ENABLED=true
NEXUS_TRADER_PROFILE_PATH=data/trader_style_profile.json

# Paper Trading
NEXUS_PAPER_MAX_DD_PCT=0.30
NEXUS_PAPER_DAILY_LOSS_PCT=0.05
NEXUS_PAPER_MAX_POSITION_PCT=0.03
NEXUS_PAPER_EXPLORATION_ENABLED=true
NEXUS_PAPER_EXPLORATION_MIN_SCORE=0.52

# Logging
ICT_LOG_LEVEL=INFO

# CORS (for development)
ICT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
